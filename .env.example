# ==============================================================================
# NIET Dissertation Management System - Environment Configuration Template
# ==============================================================================
#
# IMPORTANT SECURITY RULES:
# - NEVER commit sensitive secrets, service-role keys, or database passwords to git.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY or any server secret to NEXT_PUBLIC_ variables.
# - Create a local `.env.local` file for your active local development configuration.
#
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Client Configuration (Public Anon Key only)
# Development (Local Supabase or Dev Project):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Production Supabase Target:
# NEXT_PUBLIC_SUPABASE_URL=https://gumznxfcjueecsutopek.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_supabase_anon_key_here

# Server-Side Only Database Direct Connection (For Migration/Harness CLI, NEVER in frontend)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.gumznxfcjueecsutopek.supabase.co:5432/postgres
